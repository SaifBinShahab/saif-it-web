# Web3Forms — get a free access key at https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# YouTube channel ID — must be the actual ID (starts with "UC", 24 chars),
# NOT your @handle or a custom URL. On your channel page: go to
# "Share channel" > "Copy channel ID" to get the right value.
# Used only to pull the public RSS feed at build time — no API key needed.
PUBLIC_YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
