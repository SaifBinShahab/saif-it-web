---
// Reusable FAQ accordion using native <details>/<summary> — no JS needed,
// works with any language direction, accessible by default. Drop onto any
// page: <FAQ items={[{ q: "...", a: "..." }]} />
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;
---
<div class={`divide-y divide-[var(--border)] ${className}`}>
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-medium leading-snug marker:content-none">
        {item.q}
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--border)] text-[var(--text-muted)] transition-all duration-200 group-open:rotate-45 group-open:border-[var(--accent)] group-open:text-[var(--accent)]">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </summary>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">{item.a}</p>
    </details>
  ))}
</div>
