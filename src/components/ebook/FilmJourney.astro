---
// Cinematic, scroll-driven "film" for the Bangla e-book landing page.
//
// The whole thing is one tall wrapper with a sticky 100svh stage. A small
// vanilla engine maps scroll progress (0 → 1) to a timeline of ten beats:
// hero → book opens → pages scatter → topics gather into pages → learning
// outcomes → pages assemble into a path → the reader travels the path and
// changes colour → beacon in the dark → "you too can become cyber-aware" →
// the book returns for the final order CTA.
//
// The visual effects (3D book, aurora, glass, gradient type) are an
// owner-approved exception scoped to this page / component only.
import Button from "@/components/ui/Button.astro";
import { ebookChapters } from "@/data/ebook";

interface Props {
  ctaHref: string;
}

const { ctaHref = "#pricing" } = Astro.props;

const chapters = [
  {
    label: "পরিচয়",
    kicker: "বাংলা ডিজিটাল ই-বুক",
    title: 'আপনার অনলাইন জীবন, <span class="fj-grad">আরও নিরাপদ।</span>',
    body: "মোবাইল ব্যাংকিং, ফেসবুক, পাসওয়ার্ড, হোম ওয়াইফাই — প্রতিদিনের ডিজিটাল জীবনের নিরাপত্তা, সহজ বাংলায়। আগে থেকে কোনো টেকনিক্যাল জ্ঞান লাগবে না।",
    cta: "বইটি সংগ্রহ করুন",
    note: "স্ক্রল করুন — ভেতরের যাত্রা শুরু হবে",
    hero: true,
    tags: ["সহজ বাংলা", "শুরু থেকে", "যেকোনো ডিভাইস"],
  },
  {
    label: "আট অধ্যায়",
    kicker: "একটি বই, আটটি অধ্যায়",
    title: "একটা বই খুললে ভেতরে থাকে আলাদা আলাদা বিষয়।",
    body: "প্রতিদিন আপনি যেসব জিনিস ব্যবহার করেন, তার প্রতিটির জন্য আলাদা করে জানার আছে।",
    cta: "আটটি অধ্যায় একসাথে নিন",
  },
  {
    label: "ছড়িয়ে",
    kicker: "ছড়িয়ে থাকা প্রশ্ন",
    title: "নিরাপত্তার প্রশ্নগুলো আপনার জীবনের সব জায়গায় ছড়িয়ে আছে।",
    body: "ফোনে, ব্যাংকে, ব্রাউজারে, বাসার ওয়াইফাইয়ে। কোন প্রশ্নটা কোথায় — সেটাই আগে বুঝতে হবে।",
    cta: "প্রথম অধ্যায় থেকে শুরু করুন",
  },
  {
    label: "এক জায়গায়",
    kicker: "এক জায়গায়",
    title: "ছড়িয়ে থাকা বিষয়গুলো যখন এক জায়গায় আসে।",
    body: "আটটি অধ্যায়ে সাজানো — প্রতিটি পাতায় একটি করে পরিষ্কার উত্তর।",
    cta: "গুছানো উত্তরগুলো নিন",
  },
  {
    label: "শিক্ষা",
    kicker: "প্রতিটি পাতার শিক্ষা",
    title: "এক পাতায়, একটি করে কাজের শিক্ষা।",
    body: "শুধু তথ্য নয় — কোন পরিস্থিতিতে ঠিক কী করবেন, সেটাই লেখা।",
    cta: "কাজের শিক্ষাটা নিন",
  },
  {
    label: "পথ",
    kicker: "আপনার যাত্রা",
    title: "আটটি অধ্যায়, একটি পথ।",
    body: "শুরুটা ছোট — একটি অভ্যাস বদলালেই ঝুঁকি অনেকটা কমে আসে। বাকিটা ধাপে ধাপে।",
    cta: "পথের প্রথম ধাপ নিন",
  },
  {
    label: "যাত্রা",
    kicker: "ধাপে ধাপে",
    title: "প্রতিটি পাতায় একটি করে অভ্যাস তৈরি হবে।",
    body: "যাত্রার মাঝপথে আপনি নিজেই বুঝতে পারবেন — কোনটা আপনার জন্য সবচেয়ে জরুরি।",
    cta: "এই যাত্রায় যুক্ত হোন",
    live: true,
  },
  {
    label: "আলো",
    kicker: "পথের শেষে",
    title: "শেষে থেকে যায় শুধু একটি অভ্যাস।",
    body: "জ্ঞানটুকু আপনার সাথে থাকে — বইয়ের বাইরেও, প্রতিদিনের কাজে।",
    cta: "নিজের জন্য বইটি নিন",
  },
  {
    label: "শেষ কথা",
    kicker: "শেষ কথা",
    title: 'আপনিও হতে পারেন <span class="fj-grad">সাইবার-সচেতন।</span>',
    body: "সাইবার নিরাপত্তা শুধু বিশেষজ্ঞদের জন্য নয় — এটি প্রতিদিনের সচেতনতার অভ্যাস।",
    cta: "আজই শুরু করুন",
    align: "center",
  },
  {
    label: "বই",
    kicker: "সবার জন্য সাইবার নিরাপত্তা",
    title: "সহজ বাংলায় লেখা, শুরু থেকে পড়ার মতো।",
    body: "একবার সংগ্রহ করলে যতবার প্রয়োজন, ততবার ডাউনলোড। যেকোনো ডিভাইসে, যেকোনো সময়।",
    cta: "অর্ডার করুন",
    price: "৳TBA",
    secondary: "প্রশ্ন আছে?",
    align: "center",
  },
];

const bn = (value: number) =>
  String(value).replace(/[0-9]/g, (d) => "০১২৩৪৫৬৭৮৯"[Number(d)]);
const totalBn = bn(chapters.length);
const pageTotalBn = bn(ebookChapters.length);

// Deterministic dust so the dark room feels alive without a canvas.
const dust = Array.from({ length: 18 }, (_, i) => ({
  x: (i * 37 + 11) % 100,
  y: (i * 53 + 7) % 100,
  delay: -((i * 1.7) % 12),
  size: 1 + (i % 3) * 0.7,
  dur: 9 + (i % 5) * 2.4,
}));
---

<section class="fj" data-film aria-labelledby="fj-title">
  <noscript><style>
    .fj { height: auto !important; }
    .fj-viewport { display: none !important; }
    .fj-fallback { display: grid !important; }
  </style></noscript>

  <!-- Reduced-motion / no-JS version: a calm editorial read of the same beats. -->
  <div class="fj-fallback" data-fallback>
    {chapters.map((c, i) => (
      <article class:list={["fj-fb-card", i === 0 && "fj-fb-lead"]} data-reveal>
        <p class="fj-fb-kicker">{c.kicker}</p>
        {i === 0 ? (
          <h1 id="fj-title" class="fj-fb-title" set:html={c.title} />
        ) : (
          <h2 class="fj-fb-title" set:html={c.title} />
        )}
        <p class="fj-fb-body">{c.body}</p>
        {c.price && <p class="fj-fb-price">{c.price}</p>}
        <a class="fj-fb-cta" href={ctaHref}>
          {c.cta}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>

  <div class="fj-viewport" data-viewport data-align="left">
    <!-- ---------- backdrop ---------- -->
    <div class="fj-bg" aria-hidden="true">
      <div class="fj-grid"></div>
      <div class="fj-light"></div>
      <div class="fj-light fj-light-brass"></div>
      <div class="fj-vignette"></div>
      <div class="fj-dust">
        {dust.map((d) => (
          <span
            style={`left:${d.x}%;top:${d.y}%;--d:${d.delay}s;--s:${d.size}px;--dur:${d.dur}s`}
          />
        ))}
      </div>
      <div class="fj-shade" data-shade></div>
    </div>

    <!-- ---------- progress HUD ---------- -->
    <div class="fj-hud" data-hud aria-hidden="true">
      <span class="fj-hud-count"><b data-hud-index>০১</b> / {totalBn}</span>
      <span class="fj-hud-track"><i data-hud-bar></i></span>
      <span class="fj-hud-label" data-hud-label>পরিচয়</span>
    </div>

    <!-- ---------- the scene ---------- -->
    <div class="fj-scene" data-scene>
      <svg class="fj-web" data-web viewBox="0 0 1000 800" aria-hidden="true">
        <path class="fj-web-lines" data-web-path></path>
        <path class="fj-track-glow" data-track-glow></path>
        <path class="fj-track" data-track></path>
      </svg>

      <!-- 3D book -->
      <div class="fj-book" data-book role="img" aria-label="বইয়ের থ্রি-ডি প্রিভিউ — ড্র্যাগ করে ঘোরানো যায়">
        <div class="fj-book-aura"></div>
        <div class="fj-shield" aria-hidden="true">
          <svg viewBox="0 0 400 440" fill="none">
            <polygon class="fj-shield-1" points="200,14 384,116 384,324 200,426 16,324 16,116" />
            <polygon class="fj-shield-2" points="200,54 348,134 348,306 200,386 52,306 52,134" />
            <polygon class="fj-shield-3" points="200,94 312,152 312,288 200,346 88,288 88,152" />
            <path class="fj-shield-lines" d="M200 14v412M16 116l368 208M384 116L16 324M200 54 348 306M200 54 52 306M200 386 348 134M200 386 52 134" />
          </svg>
        </div>
        <div class="fj-sway">
          <div class="fj-tilt" data-book-tilt>
            <div class="fj-book3d">
              <div class="fj-bface fj-bback" aria-hidden="true"></div>
              <div class="fj-bface fj-bspine" aria-hidden="true"></div>
              <div class="fj-bface fj-bpages" aria-hidden="true"></div>
              <div class="fj-bsheet" style="--i:1" aria-hidden="true"></div>
              <div class="fj-bsheet" style="--i:2" aria-hidden="true"></div>
              <div class="fj-bsheet" style="--i:3" aria-hidden="true"></div>
              <div class="fj-bsheet" style="--i:4" aria-hidden="true"></div>
              <div class="fj-bface fj-bfront" data-book-front>
                <img
                  class="fj-cover-art"
                  src="/images/works/ebook-cover-art.svg"
                  alt=""
                  width="640"
                  height="870"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="fj-cover-shade" aria-hidden="true"></span>
                <span class="fj-cover-text" aria-hidden="true">
                  <span class="fj-cover-kicker">ই-বুক</span>
                  <span class="fj-cover-title">সবার জন্য<br />সাইবার নিরাপত্তা</span>
                  <span class="fj-cover-author">সাইফ বিন শাহাব</span>
                </span>
                <span class="fj-sheen" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
        <div class="fj-bshadow" aria-hidden="true"></div>
        <span class="fj-bhint" aria-hidden="true">ড্র্যাগ করে ঘুরিয়ে দেখুন</span>
      </div>

      <!-- loose pages -->
      <div class="fj-pages" data-pages>
        {ebookChapters.map((c, i) => (
          <article class="fj-page" data-page style={`--i:${i}`}>
            <span class="fj-page-chip" aria-hidden="true">{c.title}</span>
            <div class="fj-page-face">
              <span class="fj-page-ruler" aria-hidden="true"></span>
              <div class="fj-page-top">
                <span class="fj-page-num">{c.n}</span>
                <span class="fj-page-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
                </span>
              </div>
              <h3 class="fj-page-title">{c.title}</h3>
              <div class="fj-page-tags" aria-hidden="true">
                {c.tags.map((t) => <span>{t}</span>)}
              </div>
              <p class="fj-page-out">{c.outcome}</p>
              <span class="fj-page-glow" aria-hidden="true"></span>
            </div>
          </article>
        ))}
      </div>

      <!-- the reader / beacon -->
      <div class="fj-reader" data-reader aria-hidden="true">
        <span class="fj-reader-halo"></span>
        <span class="fj-reader-ring"></span>
        <span class="fj-reader-core"></span>
      </div>
    </div>

    <!-- ---------- copy ---------- -->
    <div class="fj-copy" data-copy>
      {chapters.map((c, i) => (
        <article
          class:list={["fj-ch", i === 0 && "is-on"]}
          data-chapter={i}
          data-align={c.align ?? "left"}
          data-label={c.label}
        >
          <p class="fj-kicker"><span class="fj-kicker-line"></span>{c.kicker}</p>
          {c.hero ? (
            <h1 id="fj-title" class="fj-title fj-title-hero" set:html={c.title} />
          ) : (
            <h2 class="fj-title" set:html={c.title} />
          )}
          {c.live && (
            <p class="fj-live">
              <span class="fj-live-dot" aria-hidden="true"></span>
              <span data-live-title>{ebookChapters[0].title}</span>
              <span class="fj-live-count">
                <span data-live-count>{bn(1)}</span> / {pageTotalBn}
              </span>
            </p>
          )}
          <p class="fj-body">{c.body}</p>
          {c.hero && (
            <div class="fj-tags">
              {c.tags?.map((t) => <span>{t}</span>)}
            </div>
          )}
          {c.price && <p class="fj-price">{c.price}</p>}
          <div class="fj-actions">
            <a class="fj-cta" href={ctaHref}>
              <span>{c.cta}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            {c.secondary && (
              <a class="fj-secondary" href="#faq">{c.secondary} <span aria-hidden="true">↓</span></a>
            )}
          </div>
          {c.note && <p class="fj-note"><span aria-hidden="true">↓</span> {c.note}</p>}
        </article>
      ))}
    </div>

    <!-- ---------- chapter rail ---------- -->
    <nav class="fj-rail" aria-label="অধ্যায়সমূহ">
      {chapters.map((c, i) => (
        <button
          type="button"
          class:list={["fj-rail-dot", i === 0 && "is-active"]}
          data-goto={i}
          aria-label={`${bn(i + 1)} — ${c.label}`}
          title={c.label}
        >
          <span aria-hidden="true"></span>
        </button>
      ))}
    </nav>
  </div>
</section>

<style>
  /* ============================================================
     Page-scoped cinematic system. Everything is namespaced .fj-*
     so none of it leaks into the rest of the site.
     ============================================================ */
  .fj {
    --fj-bg: #070b0d;
    --fj-bg-2: #0c1417;
    --fj-ink: #f4f1ea;
    --fj-muted: rgba(244, 241, 234, 0.62);
    --fj-faint: rgba(244, 241, 234, 0.34);
    --fj-line: rgba(244, 241, 234, 0.1);
    --fj-panel: rgba(255, 255, 255, 0.05);
    --fj-jade: #5fd3b0;
    --fj-jade-rgb: 95 211 176;
    --fj-brass: #e2bd85;
    --fj-brass-rgb: 226 189 133;
    --fj-shadow: rgba(0, 0, 0, 0.7);
    --fj-shade: #000000;
    --fj-shade-max: 0.62;

    position: relative;
    height: 900svh;
    color: var(--fj-ink);
    background: var(--fj-bg);
  }

  :global([data-theme="light"]) .fj {
    --fj-bg: #ece7dc;
    --fj-bg-2: #f5f1e8;
    --fj-ink: #12181b;
    --fj-muted: #5a636a;
    --fj-faint: rgba(18, 24, 27, 0.4);
    --fj-line: rgba(18, 24, 27, 0.13);
    --fj-panel: rgba(255, 255, 255, 0.58);
    --fj-jade: #2f7f6b;
    --fj-jade-rgb: 47 127 107;
    --fj-brass: #98743a;
    --fj-brass-rgb: 152 116 58;
    --fj-shadow: rgba(18, 24, 27, 0.26);
    --fj-shade: #241d12;
    --fj-shade-max: 0.4;
  }

  .fj-viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(var(--fj-jade-rgb) / 0.05), transparent 70%),
      linear-gradient(180deg, var(--fj-bg-2), var(--fj-bg));
    transition: background-color 0.4s ease;
  }

  /* ---------- backdrop ---------- */
  .fj-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .fj-grid {
    position: absolute;
    inset: -20%;
    background-image:
      repeating-linear-gradient(60deg, var(--fj-line) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(-60deg, var(--fj-line) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, var(--fj-line) 0 1px, transparent 1px 144px);
    opacity: 0.34;
    mask-image: radial-gradient(ellipse 60% 55% at 55% 45%, #000 10%, transparent 76%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 55% 45%, #000 10%, transparent 76%);
  }

  .fj-light {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--lx, 64%) var(--ly, 48%),
      rgb(var(--lc, 95 211 176) / 0.2) 0%,
      rgb(var(--lc, 95 211 176) / 0.07) 26%,
      transparent 60%
    );
    transition: background 0.3s linear;
  }

  .fj-light-brass {
    background: radial-gradient(
      ellipse 55% 45% at 20% 100%,
      rgb(var(--fj-brass-rgb) / 0.12),
      transparent 70%
    );
  }

  .fj-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 65% at 50% 45%, transparent 40%, rgba(0, 0, 0, 0.5) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent 18%, transparent 82%, rgba(0, 0, 0, 0.45));
  }

  :global([data-theme="light"]) .fj-vignette {
    background:
      radial-gradient(ellipse 70% 65% at 50% 45%, transparent 45%, rgba(52, 42, 28, 0.22) 100%),
      linear-gradient(180deg, rgba(52, 42, 28, 0.1), transparent 18%, transparent 82%, rgba(52, 42, 28, 0.12));
  }

  .fj-dust span {
    position: absolute;
    width: var(--s, 1px);
    height: var(--s, 1px);
    border-radius: 50%;
    background: var(--fj-brass);
    opacity: 0.5;
    animation: fj-dust var(--dur, 12s) linear var(--d, 0s) infinite;
  }

  .fj-shade {
    position: absolute;
    inset: 0;
    background: var(--fj-shade);
    opacity: calc(var(--dim, 0) * var(--fj-shade-max));
  }

  /* ---------- HUD ---------- */
  .fj-hud {
    position: absolute;
    top: calc(4.85rem + env(safe-area-inset-top, 0px));
    left: clamp(1.25rem, 5vw, 4.5rem);
    right: clamp(2.6rem, 5vw, 4.5rem);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: theme("fontFamily.mono");
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fj-faint);
    opacity: var(--hudop, 1);
    transition: opacity 0.5s ease;
  }

  .fj-hud-count b {
    font-weight: 500;
    color: var(--fj-brass);
  }

  .fj-hud-track {
    position: relative;
    flex: 1;
    max-width: 9rem;
    height: 1px;
    background: var(--fj-line);
    overflow: hidden;
  }

  .fj-hud-track i {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--progress, 0%);
    background: linear-gradient(90deg, var(--fj-jade), var(--fj-brass));
  }

  .fj-hud-label {
    margin-left: auto;
    color: var(--fj-muted);
    white-space: nowrap;
  }

  /* ---------- scene shell ---------- */
  .fj-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .fj-web {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .fj-web-lines {
    fill: none;
    stroke: var(--fj-jade);
    stroke-width: 1;
    stroke-opacity: 0.24;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  .fj-track,
  .fj-track-glow {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .fj-track {
    stroke: var(--fj-jade);
    stroke-width: 1.9;
    stroke-dasharray: 3 8;
    stroke-opacity: 0.85;
  }

  .fj-track-glow {
    stroke: var(--fj-jade);
    stroke-width: 7;
    stroke-opacity: 0.1;
  }

  /* ---------- pages ---------- */
  .fj-pages {
    --cw: 200px;
    position: absolute;
    inset: 0;
    z-index: 5;
    perspective: 1500px;
    perspective-origin: 50% 48%;
    pointer-events: none;
  }

  .fj-page {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--cw);
    height: calc(var(--cw) * 1.34);
    margin-left: calc(var(--cw) / -2);
    margin-top: calc(var(--cw) * -0.67);
    opacity: 0;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .fj-page-face {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 1rem 0.9rem 0.95rem;
    border-radius: 9px 5px 5px 9px;
    overflow: hidden;
    color: #16211f;
    text-align: center;
    background:
      linear-gradient(102deg, rgba(255, 255, 255, 0.9), transparent 24%),
      linear-gradient(180deg, #fbf8f1 0%, #f1ece1 78%, #e4ddcf 100%);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 24px 46px -22px rgba(0, 0, 0, 0.72),
      0 0 0 1px rgba(var(--fj-brass-rgb) / 0.22);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.24rem;
  }

  .fj-page-face::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(18, 24, 27, 0.045) 0 1px, transparent 1px 7px);
    opacity: 0.5;
    pointer-events: none;
  }

  .fj-page-face::after {
    content: "";
    position: absolute;
    top: 4%;
    bottom: 4%;
    left: 4px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, rgba(176, 141, 87, 0.45), transparent);
  }

  .fj-page-ruler {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: repeating-linear-gradient(0deg, rgba(18, 24, 27, 0.12) 0 1px, transparent 1px 9px);
    opacity: 0.7;
  }

  .fj-page-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    width: 100%;
  }

  .fj-page-num {
    font-family: theme("fontFamily.mono");
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: #9a7b46;
  }

  .fj-page-icon {
    display: inline-flex;
    color: #2f7f6b;
    opacity: 0.85;
  }

  .fj-page-icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .fj-page-title {
    position: relative;
    margin-top: 0.35rem;
    font-family: theme("fontFamily.heading-bn");
    font-size: 1.14rem;
    line-height: 1.34;
    font-weight: 600;
    color: #12181b;
    opacity: 0.45;
    transition: opacity 0.5s ease;
  }

  .fj-page-tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.28rem;
    margin-top: 0.35rem;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .fj-page-tags span {
    padding: 0.2rem 0.46rem;
    border-radius: 999px;
    border: 1px solid rgba(47, 79, 68, 0.28);
    background: rgba(47, 127, 107, 0.07);
    font-family: theme("fontFamily.mono");
    font-size: 0.54rem;
    letter-spacing: 0.03em;
    color: #3f5a52;
    white-space: nowrap;
  }

  .fj-page-out {
    position: relative;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(176, 141, 87, 0.3);
    font-family: theme("fontFamily.body-bn");
    font-size: 0.88rem;
    line-height: 1.58;
    color: #37433f;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .fj-page-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 100% 0%, rgba(95, 211, 176, 0.2), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .fj-pages.is-scattered .fj-page-chip {
    opacity: 1;
  }

  .fj-pages.is-scattered .fj-page-chip {
    transform: translate3d(-26px, -46px, 0) rotate(-6deg);
  }

  .fj-pages.is-gathered .fj-page-title {
    opacity: 1;
  }

  .fj-pages.is-gathered .fj-page-tags {
    opacity: 1;
  }

  .fj-pages.is-gathered .fj-page-chip {
    opacity: 0;
    transform: translate3d(0, 0, 0) rotate(0deg);
  }

  .fj-pages.is-outcome .fj-page-out {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--i) * 70ms);
  }

  .fj-pages.is-outcome .fj-page-tags {
    opacity: 0;
    transition-delay: 0ms;
  }

  .fj-page-glow {
    opacity: 0.35;
  }

  .fj-page-chip {
    position: absolute;
    z-index: 4;
    left: 8%;
    top: 6%;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    background: rgba(8, 13, 15, 0.88);
    border: 1px solid rgba(var(--fj-brass-rgb) / 0.45);
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    color: #f4f1ea;
    font-family: theme("fontFamily.mono");
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(0, 0, 0) rotate(0deg);
    transition: opacity 0.6s ease, transform 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  /* ---------- 3D book ---------- */
  .fj-book {
    --bw: clamp(168px, 16vw, 250px);
    --bh: calc(var(--bw) * 1.36);
    --bd: clamp(24px, 2.4vw, 40px);
    position: absolute;
    left: 64%;
    top: 50%;
    width: calc(var(--bw) * 1.8);
    height: calc(var(--bh) * 1.7);
    margin-left: calc(var(--bw) * -0.9);
    margin-top: calc(var(--bh) * -0.85);
    z-index: 4;
    opacity: var(--bop, 1);
    will-change: transform, opacity;
    transform: translate3d(var(--btx, 0px), var(--bty, 0px), 0) scale(var(--bscale, 1));
    transform-style: preserve-3d;
  }

  .fj-book-aura {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--fj-jade-rgb) / 0.24), transparent 60%);
    filter: blur(38px);
  }

  .fj-shield {
    position: absolute;
    inset: 4% 12%;
    display: grid;
    place-items: center;
    animation: fj-turn 26s linear infinite;
    opacity: 0.9;
  }

  .fj-shield svg {
    width: 100%;
    height: 100%;
  }

  .fj-shield-1 {
    stroke: var(--fj-brass);
    stroke-opacity: 0.55;
    stroke-width: 1.2;
  }

  .fj-shield-2 {
    stroke: var(--fj-jade);
    stroke-opacity: 0.4;
    stroke-width: 0.8;
  }

  .fj-shield-3 {
    stroke: var(--fj-brass);
    stroke-opacity: 0.22;
    stroke-width: 0.7;
  }

  .fj-shield-lines {
    stroke: var(--fj-jade);
    stroke-opacity: 0.16;
    stroke-width: 0.6;
  }

  .fj-sway {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    animation: fj-sway 9s ease-in-out infinite;
  }

  .fj-tilt {
    transform-style: preserve-3d;
    transform: rotateX(var(--brx, 6deg)) rotateY(var(--bry, -18deg));
    transition: transform 0.2s ease-out;
    will-change: transform;
  }

  .fj-tilt.is-dragging {
    transition: none;
  }

  .fj-book3d {
    position: relative;
    width: var(--bw);
    height: var(--bh);
    transform-style: preserve-3d;
  }

  .fj-bface {
    position: absolute;
    inset: 0;
    border-radius: 5px 10px 10px 5px;
  }

  .fj-bfront {
    z-index: 5;
    overflow: hidden;
    background: #0a0f12;
    transform: translateZ(calc(var(--bd) / 2 + var(--open, 0) * 22px)) rotateY(calc(var(--open, 0) * -54deg));
    transform-origin: left center;
    box-shadow:
      0 0 0 1px rgba(var(--fj-jade-rgb) / 0.4),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 45px 80px -34px rgba(0, 0, 0, 0.9);
    transition: transform 0.1s linear;
  }

  .fj-cover-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }

  .fj-cover-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 10, 12, 0.1) 0%, rgba(6, 10, 12, 0.12) 38%, rgba(6, 10, 12, 0.94) 100%),
      linear-gradient(90deg, rgba(6, 10, 12, 0.45) 0%, transparent 26%);
  }

  .fj-cover-text {
    position: absolute;
    inset: auto 0 0;
    display: block;
    padding: 1.1rem 0.95rem 1.15rem 1.35rem;
    color: #f4f1ea;
  }

  .fj-cover-kicker {
    display: block;
    font-family: theme("fontFamily.mono");
    font-size: 0.54rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--fj-brass);
    margin-bottom: 0.42rem;
  }

  .fj-cover-title {
    display: block;
    font-family: theme("fontFamily.heading-bn");
    font-size: clamp(0.95rem, 1.5vw, 1.3rem);
    line-height: 1.3;
    font-weight: 600;
    color: #f4f1ea;
  }

  .fj-cover-author {
    display: block;
    margin-top: 0.45rem;
    font-family: theme("fontFamily.body-bn");
    font-size: 0.64rem;
    color: rgba(244, 241, 234, 0.72);
  }

  .fj-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.18) 46%, transparent 60%);
    transform: translateX(-30%);
    animation: fj-sheen 8s ease-in-out infinite;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .fj-bspine {
    width: var(--bd);
    height: 100%;
    left: calc(var(--bd) / -2);
    right: auto;
    transform: rotateY(90deg);
    border-radius: 2px;
    background: linear-gradient(90deg, #5a4527 0%, #a67f4a 28%, #edcf95 52%, #8a6a3c 78%, #4a3a22 100%);
    box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.45);
  }

  .fj-bpages {
    width: var(--bd);
    height: 100%;
    right: calc(var(--bd) / -2);
    left: auto;
    transform: rotateY(-90deg);
    background: repeating-linear-gradient(90deg, #efe9dc 0 1px, #cfc7b6 2px, #e6dfd0 3px);
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.3);
  }

  .fj-bback {
    transform: rotateY(180deg) translateZ(calc(var(--bd) / 2));
    background: linear-gradient(135deg, #162025 0%, #0a0e10 70%);
    border-radius: 10px 5px 5px 10px;
    box-shadow: inset 0 0 0 1px rgba(var(--fj-jade-rgb) / 0.22);
  }

  .fj-bsheet {
    position: absolute;
    inset: 3% 1.5% 3% 1%;
    border-radius: 1px 5px 5px 1px;
    background: linear-gradient(90deg, #d4ccba, #faf6ed 9%, #efe9dc 62%, #d8d0bf);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    transform: translateZ(calc(var(--bd) / 2 - 5px - var(--i, 1) * 2.4px)) rotateZ(calc(var(--open, 0) * var(--i, 1) * 0.5deg));
    opacity: calc(var(--open, 0) * 0.75);
  }

  .fj-bsheet::after {
    content: "";
    position: absolute;
    inset: 13% 13% 11% 17%;
    background: repeating-linear-gradient(
      180deg,
      transparent 0 7px,
      rgba(86, 74, 52, 0.2) 7px 8px
    );
    opacity: calc(var(--open, 0) * 0.9);
  }

  .fj-bshadow {
    position: absolute;
    left: 50%;
    bottom: 11%;
    width: calc(var(--bw) * 1.15);
    height: 44px;
    margin-left: calc(var(--bw) * -0.575);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.66), transparent 68%);
    filter: blur(14px);
    transform: rotateX(70deg);
    animation: fj-shadow 9s ease-in-out infinite;
  }

  .fj-bhint {
    position: absolute;
    left: 50%;
    bottom: -0.4rem;
    transform: translateX(-50%);
    font-family: theme("fontFamily.mono");
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fj-faint);
    white-space: nowrap;
    opacity: var(--hintop, 0.7);
    transition: opacity 0.4s ease;
  }

  /* ---------- reader ---------- */
  .fj-reader {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    width: 0;
    height: 0;
    opacity: var(--ro, 0);
    transform: translate3d(var(--rx, 0px), var(--ry, 0px), 0) scale(var(--rs, 1));
    will-change: transform, opacity;
  }

  .fj-reader-core {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgb(var(--rc, 150 160 171));
    box-shadow:
      0 0 22px 7px rgb(var(--rc, 150 160 171) / 0.6),
      0 0 70px 24px rgb(var(--rc, 150 160 171) / 0.26);
  }

  .fj-reader-halo {
    position: absolute;
    left: -52px;
    top: -52px;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--rc, 107 117 128) / 0.22), transparent 62%);
    animation: fj-breathe 3.4s ease-in-out infinite;
  }

  .fj-reader-ring {
    position: absolute;
    left: -26px;
    top: -26px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgb(var(--rc, 107 117 128) / 0.45);
    animation: fj-ping 3.4s ease-out infinite;
  }

  /* ---------- copy ---------- */
  .fj-copy {
    position: absolute;
    left: clamp(1.25rem, 5vw, 4.5rem);
    top: 50%;
    bottom: auto;
    z-index: 30;
    width: min(33rem, 46vw);
    transition:
      left 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
      top 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fj-copy::before {
    content: "";
    position: absolute;
    top: -9rem;
    bottom: -9rem;
    left: -22%;
    right: -18%;
    z-index: -1;
    background: radial-gradient(ellipse at 30% 50%, rgba(0, 0, 0, 0.5), transparent 68%);
    opacity: 0.9;
    pointer-events: none;
  }

  :global([data-theme="light"]) .fj-copy::before {
    background: radial-gradient(ellipse at 30% 50%, rgba(236, 231, 220, 0.82), transparent 70%);
  }

  .fj-ch {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(-50% + 18px));
    transition:
      opacity 0.55s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.55s;
    pointer-events: none;
  }

  .fj-ch.is-on {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  .fj-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: theme("fontFamily.mono");
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fj-brass);
  }

  .fj-kicker-line {
    width: 1.6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--fj-brass), transparent);
  }

  .fj-title {
    margin-top: 0.85rem;
    font-family: theme("fontFamily.heading-bn");
    font-size: calc(clamp(1.75rem, 3vw, 2.75rem) * var(--font-scale));
    line-height: 1.22;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fj-ink);
    text-wrap: balance;
  }

  .fj-title-hero {
    font-size: calc(clamp(2.35rem, 5vw, 4.3rem) * var(--font-scale));
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .fj-grad {
    background: linear-gradient(102deg, var(--fj-brass) 0%, #f6e3bb 42%, var(--fj-jade) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global([data-theme="light"]) .fj-grad {
    background: linear-gradient(102deg, #8a6626 0%, #b08d57 45%, #2f7f6b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fj-body {
    margin-top: 1rem;
    max-width: 32rem;
    font-family: theme("fontFamily.body-bn");
    font-size: calc(1.08rem * var(--font-scale));
    line-height: 1.82;
    color: var(--fj-muted);
  }

  .fj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .fj-tags span {
    padding: 0.4rem 0.82rem;
    border-radius: 999px;
    border: 1px solid var(--fj-line);
    background: var(--fj-panel);
    backdrop-filter: blur(10px);
    font-family: theme("fontFamily.mono");
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--fj-muted);
  }

  .fj-live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--fj-jade-rgb) / 0.32);
    background: rgba(var(--fj-jade-rgb) / 0.08);
    font-family: theme("fontFamily.mono");
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--fj-ink);
  }

  .fj-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fj-jade);
    box-shadow: 0 0 10px 3px rgba(var(--fj-jade-rgb) / 0.55);
  }

  .fj-live-count {
    color: var(--fj-muted);
  }

  .fj-price {
    margin-top: 0.4rem;
    font-family: theme("fontFamily.heading-bn");
    font-size: calc(clamp(2rem, 4vw, 3rem) * var(--font-scale));
    line-height: 1.1;
    background: linear-gradient(100deg, var(--fj-brass), #f6e3bb 55%, var(--fj-jade));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fj-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.35rem;
  }

  .fj-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.82rem 1.4rem;
    border-radius: 999px;
    background: linear-gradient(108deg, #efd7a8 0%, #c9a468 48%, #9fc3b5 115%);
    color: #0b1013;
