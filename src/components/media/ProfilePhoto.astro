---
// Fully modular, optional profile photo with a custom geometric frame that
// echoes the brand's star-polygon/tessellation motif. Supports separate
// light/dark-theme images, and renders correctly in every combination:
//  - light + dark given: both are clipped into the frame; CSS shows the
//    right one for the active theme, swapping instantly with the toggle.
//  - only one given: that image is used for both themes.
//  - neither given: the ornament renders alone, so the layout never breaks.
interface Props {
  light?: string;
  dark?: string;
  alt?: string;
  size?: number; // px, square bounding box
  class?: string;
}
const { light, dark, alt = "", size = 280, class: className = "" } = Astro.props;
const resolvedLight = light || dark;
const resolvedDark = dark || light;
const hasBoth = Boolean(light && dark && light !== dark);
const hasPhoto = Boolean(resolvedLight);
const clipId = `profile-hex-${Math.random().toString(36).slice(2, 8)}`;
---
<div class={`relative inline-block ${className}`} style={`width:${size}px; height:${size}px;`} data-reveal>
  <svg
    viewBox="0 0 100 100"
    width={size}
    height={size}
    class="absolute inset-0"
    aria-hidden={hasPhoto ? "true" : "false"}
    role={hasPhoto ? undefined : "img"}
  >
    <defs>
      <clipPath id={clipId} clipPathUnits="objectBoundingBox">
        <!-- gentle hexagonal / star-adjacent silhouette -->
        <path d="M0.5,0.02 L0.93,0.26 L0.98,0.74 L0.5,0.98 L0.02,0.74 L0.07,0.26 Z" />
      </clipPath>
    </defs>

    {hasPhoto && hasBoth && (
      <>
        <image
          href={resolvedLight}
          x="0" y="0" width="100" height="100"
          preserveAspectRatio="xMidYMid slice"
          clip-path={`url(#${clipId})`}
          class="theme-light-only"
        />
        <image
          href={resolvedDark}
          x="0" y="0" width="100" height="100"
          preserveAspectRatio="xMidYMid slice"
          clip-path={`url(#${clipId})`}
          class="theme-dark-only"
        />
      </>
    )}
    {hasPhoto && !hasBoth && (
      <image
        href={resolvedLight}
        x="0" y="0" width="100" height="100"
        preserveAspectRatio="xMidYMid slice"
        clip-path={`url(#${clipId})`}
      />
    )}

    <!-- outer frame line -->
    <path
      d="M50,2 L93,26 L98,74 L50,98 L2,74 L7,26 Z"
      fill="none"
      stroke="var(--accent)"
      stroke-width="1"
      opacity="0.9"
    />
    <!-- inner tessellation accent lines -->
    <path
      d="M50,2 L50,98 M7,26 L93,74 M93,26 L7,74"
      fill="none"
      stroke="var(--accent)"
      stroke-width="0.35"
      opacity="0.35"
    />

    {!hasPhoto && (
      <text
        x="50" y="54"
        text-anchor="middle"
        font-family="JetBrains Mono, monospace"
        font-size="7"
        fill="var(--text-muted)"
      >
        add photo
      </text>
    )}
  </svg>
</div>
