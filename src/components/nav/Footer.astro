---
import Container from "@/components/ui/Container.astro";
import { site, socialLinks, nav } from "@/data/siteConfig";
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[var(--border)] py-12">
  <Container class="flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left">
    <div>
      <p class="font-heading text-lg font-semibold">{site.name}</p>
      <p class="mt-1 max-w-xs font-mono text-sm text-[var(--accent)]">{site.tagline}</p>
    </div>

    <nav class="flex gap-6">
      {nav.map((item) => (
        <a href={item.href} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)]">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex gap-4">
      {socialLinks.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)]"
          aria-label={s.label}
        >
          {s.label}
        </a>
      ))}
    </div>
  </Container>
  <div
    class="mx-auto mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 px-6 font-mono text-xs text-[var(--text-muted)] md:px-10"
  >
    <a href="/privacy" class="hover:text-[var(--accent)]">Privacy Policy</a>
    <a href="/terms" class="hover:text-[var(--accent)]">Terms &amp; Conditions</a>
  </div>
  <p class="mt-2 text-center font-mono text-xs text-[var(--text-muted)]">
    This site is under the
    <a href="/works-license-v1" class="text-[var(--accent)] hover:underline">Works License - V1</a>.
  </p>
</footer>
