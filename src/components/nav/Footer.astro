---
import Container from "@/components/ui/Container.astro";
import { site, socialLinks, nav } from "@/data/siteConfig";
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[var(--border)] py-12">
  <Container class="flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left">
    <div>
      <p class="font-heading text-lg font-semibold">{site.name}</p>
      <p class="mt-1 max-w-xs font-mono text-sm text-[var(--accent)]">{site.tagline}</p>
    </div>

    <nav class="flex gap-6">
      {nav.map((item) => (
        <a href={item.href} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)]">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex gap-4">
      {socialLinks.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)]"
          aria-label={s.label}
        >
          {s.label}
        </a>
      ))}
    </div>
  </Container>
  <p class="mt-8 text-center font-mono text-xs text-[var(--text-muted)]">
    © {year} {site.fullName}. All rights reserved.
  </p>
</footer>
