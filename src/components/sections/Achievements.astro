---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";

const items = (await getCollection("achievements")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<section class="py-20 md:py-28">
  <Container>
    <SectionHeading kicker="Credentials" title="Achievements & Certifications" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <Card href={item.data.credentialUrl} data-reveal>
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading text-lg font-semibold leading-snug">{item.data.title}</h3>
          </div>
          <p class="mt-2 text-sm text-[var(--secondary)]">{item.data.issuer}</p>
          <p class="mt-1 font-mono text-xs text-[var(--text-muted)]">
            {item.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short" })}
          </p>
          <div class="mt-auto flex flex-wrap gap-2 pt-4">
            {item.data.tags.map((t: string) => <Tag>{t}</Tag>)}
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>
