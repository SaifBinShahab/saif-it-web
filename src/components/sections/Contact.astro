---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ContactForm from "@/components/forms/ContactForm.tsx";
import { contact } from "@/data/siteConfig";

const accessKey = contact.web3formsAccessKey;
---
<section id="contact" class="py-20 md:py-28">
  <Container class="grid gap-12 md:grid-cols-2">
    <div data-reveal>
      <SectionHeading
        kicker="Get in Touch"
        title="Let's Talk"
        subtitle="For security consulting, speaking, or just a genuine question — reach out directly."
      />
      <p class="mt-8 font-mono text-sm text-[var(--text-muted)]">
        Or email directly:
        <a href={`mailto:${contact.email}`} class="text-[var(--accent)] hover:underline">
          {contact.email}
        </a>
      </p>
    </div>

    <div data-reveal>
      {accessKey ? (
        <ContactForm client:visible accessKey={accessKey} />
      ) : (
        <p class="rounded-lg border border-dashed border-[var(--border)] p-4 text-sm text-[var(--text-muted)]">
          Set <code class="font-mono">contact.web3formsAccessKey</code> in <code class="font-mono">siteConfig.ts</code> to activate this form.
        </p>
      )}
    </div>
  </Container>
</section>
