---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Tag from "@/components/ui/Tag.astro";

const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);

function formatDate(value: string) {
  const isYearOnly = /^\d{4}$/.test(value);
  const date = isYearOnly ? new Date(`${value}-01-01`) : new Date(value);
  const opts: Intl.DateTimeFormatOptions = isYearOnly
    ? { year: "numeric" }
    : { year: "numeric", month: "short" };
  return date.toLocaleDateString("en-US", opts);
}

function formatRange(start: string, end?: string) {
  if (!end) return formatDate(start);
  const endStr = end.trim().toLowerCase() === "present" ? "Present" : formatDate(end);
  return `${formatDate(start)} — ${endStr}`;
}
---
<section class="py-20 md:py-28">
  <Container>
    <SectionHeading kicker="Path" title="Experience" />

    <ol class="relative mt-14 space-y-12 border-l border-[var(--border)] pl-8">
      {entries.map((item) => (
        <li class="relative" data-reveal>
          <span class="absolute -left-[2.35rem] top-1.5 h-3 w-3 rounded-full border-2 border-[var(--accent)] bg-[var(--bg)]"></span>
          <p class="font-mono text-xs uppercase tracking-wide text-[var(--text-muted)]">
            {formatRange(item.data.startDate, item.data.endDate)}
          </p>
          <h3 class="mt-1 font-heading text-xl font-semibold">{item.data.role}</h3>
          <p class="text-sm text-[var(--secondary)]">{item.data.organization}</p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">
            {item.data.summary}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {item.data.tags.map((t: string) => <Tag variant="skill">{t}</Tag>)}
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>
