---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import Button from "@/components/ui/Button.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<section class="py-20 md:py-28">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        kicker="Writing"
        title="Featured Reflections"
        subtitle="Notes across security, Islamic knowledge, and the intersection between them."
      />
      <Button href="/blogs" variant="ghost">All posts →</Button>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <Card href={`/blogs/${post.slug}`} data-reveal>
          <p class="mb-3 font-mono text-xs uppercase tracking-wide text-[var(--accent)]">
            {post.data.pillar.replace("-", " ")}
          </p>
          <h3 class="font-heading text-xl font-semibold leading-snug">{post.data.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{post.data.description}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-5">
            {post.data.tags.slice(0, 3).map((t: string) => <Tag>{t}</Tag>)}
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>
