---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import TestimonialsCarousel from "@/components/sections/Testimonials.tsx";

const items = (await getCollection("testimonials"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({ name: t.data.name, title: t.data.title, quote: t.data.quote }));
---
<section class="py-20 md:py-28">
  <Container>
    <SectionHeading kicker="Trust" title="What Clients Say" align="center" />
    <div class="mt-14">
      <TestimonialsCarousel client:visible items={items} />
    </div>
  </Container>
</section>
