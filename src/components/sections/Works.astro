---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import Button from "@/components/ui/Button.astro";

const items = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);
---
<section id="works" class="py-20 md:py-28">
  <Container>
    <SectionHeading
      kicker="Offerings"
      title="Works"
      subtitle="E-books, tools, and software built from real practice — available to use or download."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {items.map((item) => (
        <Card data-reveal>
          <p class="mb-2 font-mono text-xs uppercase tracking-wide text-[var(--accent)]">
            {item.data.kind}
          </p>
          <h3 class="font-heading text-xl font-semibold">{item.data.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{item.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {item.data.tags.map((t: string) => <Tag>{t}</Tag>)}
          </div>
          <div class="mt-6 flex items-center justify-between">
            {item.data.price && (
              <span class="font-mono text-sm text-[var(--secondary)]">{item.data.price}</span>
            )}
            <Button href={item.data.cta.href} variant="primary" size="sm" target="_blank">
              {item.data.cta.label}
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>
