---
// Pill-styled tag. variant controls the accent used for the border/text.
// "tech" (default) -> slate/border; "skill" -> emerald; "highlight" -> brass (sparingly).
interface Props {
  variant?: "tech" | "skill" | "highlight";
  class?: string;
}
const { variant = "tech", class: className = "" } = Astro.props;

const variants = {
  tech: "border-[var(--border)] text-[var(--text-muted)]",
  skill: "border-[var(--secondary)] text-[var(--secondary)]",
  highlight: "border-[var(--accent)] text-[var(--accent)]",
};
---
<span
  class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-mono tracking-wide transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.04] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[rgb(var(--accent-rgb)/0.12)] ${variants[variant]} ${className}`}
>
  <slot />
</span>
