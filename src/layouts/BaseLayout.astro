---
import Navbar from "@/components/nav/Navbar.astro";
import Footer from "@/components/nav/Footer.astro";
import BackgroundField from "@/components/effects/BackgroundField.tsx";
import CursorGlow from "@/components/effects/CursorGlow.tsx";
import Lightbox from "@/components/effects/Lightbox.tsx";
import "@/styles/global.css";
import { site, brandAssets, typography } from "@/data/siteConfig";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "bn";
  // Set false on pages where the ambient background field would be
  // distracting (rarely needed — it's designed to be subtle everywhere).
  showBackgroundField?: boolean;
  showCursorGlow?: boolean;
  // Scales every font-size on THIS page only (headings, body, tags — all
  // of it), without touching the site-wide default in siteConfig.ts.
  // 1 = 100%. e.g. fontScale={1.1} for a slightly larger custom page.
  fontScale?: number;
}
const {
  title,
  description = site.description,
  lang = "en",
  showBackgroundField = true,
  showCursorGlow = true,
  fontScale = typography.baseFontScale,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.fullName} — ${site.role}`;

// Falls back to the single default favicon.svg when no theme-specific
// icon is configured, so this works unchanged out of the box.
const faviconLight = brandAssets.favicon.light || brandAssets.favicon.dark || "/favicon.svg";
const faviconDark = brandAssets.favicon.dark || brandAssets.favicon.light || "/favicon.svg";
---
<!doctype html>
<html lang={lang} style={`--font-scale: ${fontScale}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" id="favicon" type="image/svg+xml" href={faviconDark} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=Amiri&display=swap"
      rel="stylesheet"
    />

    <!-- No-FOUC theme init: dark by default, respects saved preference.
         Also sets the matching favicon before first paint. -->
    <script is:inline define:vars={{ faviconLight, faviconDark }}>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "light" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", theme);
        var icon = document.getElementById("favicon");
        if (icon) icon.setAttribute("href", theme === "light" ? faviconLight : faviconDark);
      })();
    </script>
  </head>
  <body class="font-body antialiased">
    {showBackgroundField && <BackgroundField client:load />}
    {showCursorGlow && <CursorGlow client:load />}
    <Lightbox client:only="react" />

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from "@/lib/scrollReveal";
      import { initCodeCopy } from "@/lib/codeCopy";
      initScrollReveal();
      initCodeCopy();
      document.addEventListener("astro:page-load", () => {
        initScrollReveal();
        initCodeCopy();
      });
    </script>
  </body>
</html>
