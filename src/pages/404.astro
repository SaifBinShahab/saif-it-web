---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---
<BaseLayout title="Page Not Found">
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-sm text-[var(--accent)]">404</p>
    <h1 class="mt-3 font-heading text-3xl font-semibold">This page wandered off the map.</h1>
    <p class="mt-3 max-w-md text-[var(--text-muted)]">
      The page you're looking for doesn't exist, or has moved.
    </p>
    <Button href="/" class="mt-8">Back to Home</Button>
  </Container>
</BaseLayout>
