---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Tag from "@/components/ui/Tag.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.description} lang={post.data.language}>
  <Container class="py-20 md:py-28">
    <article class="mx-auto max-w-2xl">
      <p class="mb-3 font-mono text-xs uppercase tracking-wide text-[var(--accent)]">
        {post.data.pillar.replace("-", " ")}
      </p>
      <h1 class="font-heading text-3xl font-semibold leading-tight md:text-4xl">{post.data.title}</h1>
      <p class="mt-3 font-mono text-sm text-[var(--text-muted)]">
        {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((t: string) => <Tag>{t}</Tag>)}
      </div>

      <div class="prose prose-invert mt-10 max-w-none prose-headings:font-heading prose-a:text-[var(--accent)]">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>
