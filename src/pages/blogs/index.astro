---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import BlogList, { type BlogListItem } from "@/components/BlogList.tsx";
import { stripMarkdown } from "@/lib/text";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const items: BlogListItem[] = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  banner: post.data.banner,
  pubDateLabel: post.data.pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }),
  searchText: `${post.data.title} ${post.data.description} ${post.data.tags.join(" ")} ${stripMarkdown(
    post.body
  )}`.toLowerCase(),
}));
---
<BaseLayout title="Blogs">
  <Container class="py-20 md:py-28">
    <SectionHeading
      kicker="Writing"
      title="All Posts"
      subtitle="Cybersecurity, Islamic knowledge, and the intersection between them."
    />
    <div class="mt-12">
      <BlogList client:load posts={items} />
    </div>
  </Container>
</BaseLayout>
