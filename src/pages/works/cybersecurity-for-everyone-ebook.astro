---
// Bangla e-book landing page for "সবার জন্য সাইবার নিরাপত্তা".
// Route: /works/cybersecurity-for-everyone-ebook (the /works index stays a
// plain list of work cards).
//
// The page opens with <FilmJourney /> — a scroll-driven cinematic sequence
// (3D book → loose pages → topics → outcomes → a reader's path → beacon →
// the book returns). The sections below it are the calm, readable facts:
// contents, why, format, who it's for, price, FAQ, final CTA.
//
// Language: Bangla throughout (technical terms stay in Latin script).
// All order CTAs share one placeholder href, per the owner's request:
// the real checkout link will replace `orderHref` later.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import FAQ from "@/components/FAQ.astro";
import FilmJourney from "@/components/ebook/FilmJourney.astro";
import ReviewForm from "@/components/ebook/ReviewForm.tsx";
import { contact } from "@/data/siteConfig";
import {
  ebookChapters,
  ebookWhy,
  ebookFormat,
  ebookAudience,
  ebookFaq,
} from "@/data/ebook";

const orderHref = "#pricing";
const accessKey = contact.web3formsAccessKey;
---

<BaseLayout
  title="সবার জন্য সাইবার নিরাপত্তা — ই-বুক"
  description="মোবাইল ব্যাংকিং, ফেসবুক, পাসওয়ার্ড ও হোম নেটওয়ার্ক — প্রতিদিনের ডিজিটাল জীবনের নিরাপত্তা শিখুন সহজ বাংলায়।"
  lang="bn"
  showBackgroundField={false}
  showCursorGlow={false}
>
  <div class="eb-page">
    <FilmJourney ctaHref={orderHref} />

    <!-- ============ CONTENTS ============ -->
    <section class="eb-sec eb-sec-first" id="inside">
      <Container>
        <div class="eb-toc-grid">
          <div class="eb-toc-aside" data-reveal>
            <p class="eb-kicker">সূচিপত্র</p>
            <h2 class="eb-h2">ভেতরে <span class="eb-grad">কী আছে</span></h2>
            <p class="eb-lede">
              আটটি অধ্যায় — প্রতিটির শেষে ঠিক কী করবেন, তার পরিষ্কার ধাপ।
              কোনটা আগে পড়বেন, সেটা নিয়েও দুশ্চিন্তা নেই।
            </p>

            <ul class="eb-facts">
              <li><b>০৮</b><span>অধ্যায়</span></li>
              <li><b>PDF</b><span>ডিজিটাল ফরম্যাট</span></li>
              <li><b>∞</b><span>ডাউনলোড</span></li>
            </ul>

            <div class="eb-cta">
              <Button href={orderHref} variant="primary" size="md">পুরো বইটি সংগ্রহ করুন</Button>
            </div>
            <p class="eb-fine">একবার সংগ্রহ করলে — যতবার প্রয়োজন, ততবার ডাউনলোড।</p>
          </div>

          <ol class="eb-toc">
            {ebookChapters.map((c, i) => (
              <li class="eb-toc-row" data-reveal style={`--i:${i}`}>
                <span class="eb-toc-num">{c.n}</span>
                <div class="eb-toc-body">
                  <h3>{c.title}</h3>
                  <p>{c.outcome}</p>
                  <div class="eb-toc-tags">
                    {c.tags.map((t) => <span>{t}</span>)}
                  </div>
                </div>
                <span class="eb-toc-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
                </span>
              </li>
            ))}
          </ol>
        </div>
      </Container>
    </section>

    <!-- ============ WHY ============ -->
    <section class="eb-sec" id="why">
      <Container>
        <div class="eb-head" data-reveal>
          <p class="eb-kicker">কেন এই বই</p>
          <h2 class="eb-h2">একই বিষয়, <span class="eb-grad">ভিন্নভাবে বলা।</span></h2>
          <p class="eb-lede">
            নিরাপত্তা নিয়ে যা পাওয়া যায়, তার বেশিরভাগই হয় ইংরেজিতে, নয়তো
            এত টেকনিক্যাল যে শুরু করার সাহস হয় না। এই বইটা সেই ফাঁকটা ভরাতে লেখা।
          </p>
        </div>

        <div class="eb-why-grid">
          {ebookWhy.map((w) => (
            <article class="eb-card eb-why" data-reveal>
              <span class="eb-num">{w.n}</span>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </article>
          ))}
        </div>

        <div class="eb-sec-cta" data-reveal>
          <Button href={orderHref} variant="secondary" size="md">এইভাবে শেখা শুরু করুন</Button>
          <span class="eb-sec-note">আটটি অধ্যায় · সহজ বাংলা · শুরু থেকে</span>
        </div>
      </Container>
    </section>

    <!-- ============ FORMAT ============ -->
    <section class="eb-sec eb-sec-tint" id="format">
      <Container>
        <div class="eb-head" data-reveal>
          <p class="eb-kicker">ফরম্যাট ও সুবিধা</p>
          <h2 class="eb-h2">যেভাবে পড়বেন, <span class="eb-grad">যেভাবে পাবেন।</span></h2>
        </div>

        <div class="eb-format-grid">
          {ebookFormat.map((f) => (
            <article class="eb-card eb-format" data-reveal>
              <div class="eb-format-top">
                <span class="eb-format-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                </span>
                <span class="eb-format-meta">{f.meta}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>

        <div class="eb-sec-cta" data-reveal>
          <Button href={orderHref} variant="secondary" size="md">যেকোনো ডিভাইসে পড়তে নিন</Button>
        </div>
      </Container>
    </section>

    <!-- ============ AUDIENCE ============ -->
    <section class="eb-sec" id="for-you">
      <Container>
        <div class="eb-audience" data-reveal>
          <p class="eb-kicker">কাদের জন্য</p>
          <h2 class="eb-h2">এই বই <span class="eb-grad">আপনার জন্য</span>, যদি —</h2>
          <div class="eb-chips">
            {ebookAudience.map((a) => <span>{a}</span>)}
          </div>
          <p class="eb-lede eb-center">
            টেকনোলজি নিয়ে আগের কোনো জ্ঞান না থাকলেও সমস্যা নেই — বইটি শুরু থেকেই
            সহজভাবে বোঝানো শুরু হয়।
          </p>
          <div class="eb-cta eb-cta-center">
            <Button href={orderHref} variant="primary" size="md">আপনার কপিটি নিন</Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- ============ PRICING ============ -->
    <section class="eb-sec eb-sec-price" id="pricing">
      <div class="eb-price-glow" aria-hidden="true"></div>
      <Container>
        <div class="eb-price" data-reveal>
          <div class="eb-price-copy">
            <p class="eb-kicker">সংগ্রহ করুন</p>
            <h2 class="eb-h2">একটি বই, <span class="eb-grad">সারাজীবনের অভ্যাস।</span></h2>
            <p class="eb-body">
              সহজ বাংলায় লেখা, শুরু থেকে পড়ার মতো — আর সংগ্রহ করার পর
              যতবার প্রয়োজন ততবার ডাউনলোড।
            </p>
            <ul class="eb-price-list">
              <li>✓ সম্পূর্ণ বই, সহজ ও স্পষ্ট বাংলায়</li>
              <li>✓ আনলিমিটেড ডাউনলোড</li>
              <li>✓ যেকোনো ডিভাইসে পড়ার সুবিধা</li>
            </ul>
            <p class="eb-cta-line">
              <span class="eb-cta-line-icon" aria-hidden="true">✦</span>
              আপনার হাতে যা আছে, সেটা বোঝা, আর সেটা যত্নের সাথে রাখা
            </p>
          </div>

          <div class="eb-price-buy">
            <p class="eb-price-was">প্রকৃত মূল্য <s>৳TBA</s></p>
            <p class="eb-price-now">৳TBA</p>
            <p class="eb-price-caption">বর্তমান অফার মূল্য</p>
            <div class="eb-cta eb-cta-center">
              <Button href={orderHref} variant="primary" size="md">অর্ডার করুন</Button>
            </div>
            <p class="eb-fine">ডিজিটাল PDF · আনলিমিটেড ডাউনলোড</p>
          </div>
        </div>
      </Container>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="eb-sec" id="faq">
      <Container>
        <div class="eb-faq-grid">
          <div class="eb-faq-aside" data-reveal>
            <p class="eb-kicker">প্রশ্ন ও উত্তর</p>
            <h2 class="eb-h2">আপনার প্রশ্নের <span class="eb-grad">উত্তর।</span></h2>
            <p class="eb-body">
              আরও কিছু জানতে চাইলে সরাসরি যোগাযোগ করতে পারেন — উত্তর দিতে
              আমরা খুশি হব।
            </p>
            <div class="eb-cta">
              <Button href={orderHref} variant="secondary" size="md">উত্তর পেয়ে, বইটি নিন</Button>
            </div>
          </div>

          <div class="eb-faq" data-reveal>
            <FAQ items={ebookFaq} />
          </div>
        </div>
      </Container>
    </section>

    <!-- ============ FINAL ============ -->
    <section class="eb-final">
      <div class="eb-final-rings" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="eb-final-glow" aria-hidden="true"></div>
      <Container>
        <div class="eb-final-inner" data-reveal>
          <p class="eb-kicker">শুরু করুন</p>
          <h2 class="eb-final-title">
            আজই নিজেকে ও পরিবারকে
            <span class="eb-grad">নিরাপদ রাখার প্রথম ধাপ নিন।</span>
          </h2>
          <p class="eb-final-tag">
            আপনার হাতে যা আছে, সেটা বোঝা, আর সেটা যত্নের সাথে রাখা
          </p>
          <div class="eb-cta eb-cta-center">
            <Button href={orderHref} variant="primary" size="md">আপনার কপিটি নিন</Button>
          </div>
          <p class="eb-fine">৳TBA · ডিজিটাল PDF · যেকোনো ডিভাইসে</p>
        </div>
      </Container>
    </section>

    <!-- ============ REVIEW ============ -->
    <!-- Share links for readers (they open this form with the reader type
         preset): …#review-partial for partial readers, …#review-full for
         full readers. The type is not user-selectable. -->
    <section class="eb-sec eb-review" id="review">
      <Container>
        <span id="review-partial" class="eb-anchor" aria-hidden="true"></span>
        <span id="review-full" class="eb-anchor" aria-hidden="true"></span>
        <div class="eb-review-grid">
          <div class="eb-review-aside" data-reveal>
            <p class="eb-kicker">পাঠকের রিভিউ</p>
            <h2 class="eb-h2">পড়ে ফেলেছেন? <span class="eb-grad">লিখে দিন।</span></h2>
            <p class="eb-lede">
              আংশিক পড়েছেন, নাকি পুরোটাই শেষ করেছেন — আপনার ছোট রিভিউটি
              সরাসরি লেখকের কাছে পৌঁছে যাবে। এটা দিয়ে বইটা আরও সহজ ও
              আরও কাজের করার চেষ্টা হবে।
            </p>

            <div class="eb-review-links">
              <a class="eb-review-link" href="#review-partial">
                <b>আংশিক পড়েছি <span aria-hidden="true">→</span></b>
              </a>
              <a class="eb-review-link" href="#review-full">
                <b>সম্পূর্ণ বইটি পড়েছি <span aria-hidden="true">→</span></b>
              </a>
            </div>
          </div>

          <div class="eb-review-panel" data-reveal>
            <ReviewForm client:load accessKey={accessKey} />
            <noscript>
              <p class="text-sm text-[var(--text-muted)]">
                রিভিউ ফর্মটি দেখাতে জাভাস্ক্রিপ্ট চালু থাকা প্রয়োজন।
              </p>
            </noscript>
          </div>
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     Page-scoped editorial system for the sections after the film.
     The film carries its own visual language in FilmJourney.astro.
     ============================================================ */
  .eb-page {
    --eb-jade: #52c4a4;
    --eb-brass: #dcb47a;
    --eb-line: rgba(255, 255, 255, 0.09);
    --eb-panel: rgba(255, 255, 255, 0.04);
    --eb-panel-strong: rgba(255, 255, 255, 0.07);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--bg);
  }

  :global([data-theme="light"]) .eb-page {
    --eb-jade: #2f7f6b;
    --eb-brass: #98743a;
    --eb-line: rgba(18, 24, 27, 0.1);
    --eb-panel: rgba(255, 255, 255, 0.62);
    --eb-panel-strong: rgba(255, 255, 255, 0.82);
  }

  .eb-page :global(::selection) {
    background: rgba(var(--accent-rgb) / 0.35);
  }

  /* ---------- shared type ---------- */
  .eb-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: theme("fontFamily.mono");
    font-size: var(--fs-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--eb-brass);
    margin-bottom: 0.9rem;
  }

  .eb-kicker::before {
    content: "";
    width: 1.4rem;
    height: 1px;
    background: linear-gradient(90deg, var(--eb-brass), transparent);
  }

  .eb-h2 {
    font-size: calc(clamp(1.85rem, 3.6vw, 3rem) * var(--font-scale));
    line-height: 1.16;
    letter-spacing: -0.02em;
    font-weight: 600;
    text-wrap: balance;
  }

  .eb-lede {
    margin-top: 1.2rem;
    max-width: 34rem;
    font-size: var(--fs-base);
    line-height: 1.9;
    color: var(--text-muted);
  }

  .eb-body {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: var(--fs-base);
    line-height: 1.9;
    color: var(--text-muted);
  }

  .eb-grad {
    background: linear-gradient(100deg, var(--eb-brass) 0%, #f2d9a8 42%, var(--eb-jade) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global([data-theme="light"]) .eb-grad {
    background: linear-gradient(100deg, #8a6626 0%, #b08d57 45%, #2f7f6b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eb-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }

  .eb-cta-center {
    justify-content: center;
  }

  .eb-cta-line {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--eb-line);
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text-muted);
  }

  .eb-cta-line-icon {
    color: var(--eb-brass);
    font-size: 0.65rem;
    padding-top: 0.3rem;
  }

  .eb-fine {
    margin-top: 0.9rem;
    font-family: theme("fontFamily.mono");
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .eb-center {
    margin-inline: auto;
    text-align: center;
  }

  /* ---------- section shells ---------- */
  .eb-sec {
    position: relative;
    padding: clamp(3.75rem, 7.5vw, 6.5rem) 0;
  }

  .eb-sec-first {
    padding-top: clamp(3.25rem, 6vw, 5rem);
    border-top: 1px solid var(--eb-line);
    background:
      radial-gradient(ellipse 70% 50% at 78% 0%, rgba(var(--accent-rgb) / 0.07), transparent 62%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.1), transparent 30%);
  }

  :global([data-theme="light"]) .eb-sec-first {
    background:
      radial-gradient(ellipse 70% 50% at 78% 0%, rgba(var(--accent-rgb) / 0.1), transparent 62%);
    border-top-color: rgba(18, 24, 27, 0.16);
  }

  .eb-sec-tint {
    background: linear-gradient(180deg, transparent, rgba(74, 115, 103, 0.07), transparent);
    border-block: 1px solid var(--eb-line);
  }

  .eb-head {
    max-width: 42rem;
  }

  .eb-sec-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .eb-sec-note {
    font-family: theme("fontFamily.mono");
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* ---------- contents ---------- */
  .eb-toc-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 920px) {
    .eb-toc-grid {
      grid-template-columns: 0.78fr 1.22fr;
    }
  }

  .eb-toc-aside {
    position: sticky;
    top: 6rem;
  }

  .eb-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .eb-facts li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 12px;
    border: 1px solid var(--eb-line);
    background: var(--eb-panel);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    backdrop-filter: blur(10px);
  }

  .eb-facts b {
    font-family: theme("fontFamily.mono");
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--eb-brass);
  }

  .eb-toc {
    display: grid;
    counter-reset: toc;
  }

  .eb-toc-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem 1fr 2rem;
    gap: 1rem;
    align-items: start;
    padding: 1.35rem 0.4rem 1.35rem 0;
    border-top: 1px solid var(--eb-line);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .eb-toc-row:last-child {
    border-bottom: 1px solid var(--eb-line);
  }

  .eb-toc-row::before {
    content: "";
    position: absolute;
    left: -0.9rem;
    top: 50%;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--eb-jade), var(--eb-brass));
    transform: translateY(-50%);
    transition: height 0.3s ease;
  }

  .eb-toc-row:hover {
    transform: translateX(5px);
    border-color: rgba(var(--accent-rgb) / 0.4);
  }

  .eb-toc-row:hover::before {
    height: 62%;
  }

  .eb-toc-row[data-reveal] {
    transition-delay: calc(var(--i) * 45ms);
  }

